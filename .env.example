# ═══════════════════════════════════════════════════════════
#  Rebel Ristoranti — configurazione ambiente
#  cp .env.example .env  e compila i valori
# ═══════════════════════════════════════════════════════════

PORT=3000

# Percorso del database SQLite (con Docker: /data/restaurant.db, lascia così)
DB_PATH=./restaurant.db

# Admin. Se ADMIN_PASSWORD non è impostata, al primo avvio viene generata
# una password casuale e mostrata UNA volta nei log.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Segreti: se vuoti vengono generati automaticamente al primo avvio e
# salvati nel database (ogni installazione ha i propri).
# Impostali solo se vuoi controllarli tu (openssl rand -hex 32).
SESSION_SECRET=
VAPI_WEBHOOK_SECRET=

# Log dettagliati di richieste/risposte (contengono dati dei clienti): 1 = attivo
DEBUG_API=
